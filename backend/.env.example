# Copy this file to .env and fill in your real values.
# .env is gitignored and must never be committed — it holds real secrets.

# --- Database (MySQL / XAMPP by default) ---
DB_HOST=localhost
DB_NAME=ngo_db
DB_USER=root
DB_PASS=

# --- Frontend origin allowed to call this API (CORS) ---
# Must exactly match the URL your React app runs on, protocol + host + port.
APP_FRONTEND_URL=http://localhost:5173

# --- Timezone for publish dates / scheduled posts (PHP and MySQL both use it) ---
APP_TIMEZONE=Asia/Manila

# --- Gmail SMTP, used by api/contact.php via PHPMailer ---
# GMAIL_APP_PASSWORD is a 16-character App Password from your Google
# Account (Security -> 2-Step Verification -> App Passwords), NOT your
# normal Gmail login password.
GMAIL_ADDRESS=your-org-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
CONTACT_RECEIVER_EMAIL=your-org-gmail@gmail.com
# Name shown as the sender in inboxes
MAIL_FROM_NAME=CAJDEN Inc.
# Where uploaded images are served from, for pictures inside emails
# (defaults to APP_FRONTEND_URL, which is right when both share a domain)
# APP_UPLOADS_URL=https://infocajden.org

# --- Facebook link previews (optional) ---
# The App ID of a Facebook app (developers.facebook.com -> My Apps -> Create App).
# Only removes the "missing fb:app_id" warning in the Sharing Debugger;
# previews work without it.
# FB_APP_ID=123456789012345
